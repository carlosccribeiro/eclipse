.rmp-root { flex-grow: 1; padding: 6px; }
.rmp-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 4px; }
.rmp-field { min-width: 150px; margin-right: 8px; }
.rmp-button { min-width: 90px; }
.rmp-note { color: rgb(150, 150, 150); -unity-font-style: italic; margin-bottom: 2px; }
.rmp-summary { margin-bottom: 4px; -unity-font-style: bold; }
.rmp-body { flex-direction: row; flex-grow: 1; }
.rmp-graph-scroll { flex-grow: 1; min-width: 480px; }
.rmp-graph { width: 760px; height: 960px; }
.rmp-side { width: 340px; margin-left: 8px; }
.rmp-title { -unity-font-style: bold; margin-top: 8px; margin-bottom: 2px; }
.rmp-plan { white-space: normal; }
.rmp-legend { flex-direction: row; flex-wrap: wrap; }
.rmp-legend-item { flex-direction: row; align-items: center; margin-right: 8px; margin-bottom: 2px; }
.rmp-legend-swatch { width: 12px; height: 12px; margin-right: 3px; border-radius: 2px; }

.rmp-node {
    position: absolute;
    width: 100px;
    height: 40px;
    padding: 0;
    font-size: 10px;
    color: rgb(15, 15, 15);
    border-width: 2px;
    border-color: rgb(30, 30, 30);
    border-radius: 4px;
}
.rmp-node.path-min { border-color: rgb(60, 220, 90); border-width: 3px; }
.rmp-node.path-max { border-color: rgb(240, 70, 70); border-width: 3px; }
.rmp-node.path-both { border-color: rgb(255, 0, 255); border-width: 3px; }
.rmp-node.selected { border-color: rgb(255, 255, 255); border-width: 3px; }

.room-combat { background-color: rgb(200, 200, 200); }
.room-elite { background-color: rgb(235, 110, 70); }
.room-guardian { background-color: rgb(190, 130, 60); }
.room-treasure { background-color: rgb(240, 210, 70); }
.room-shrine { background-color: rgb(120, 190, 240); }
.room-event { background-color: rgb(190, 130, 220); }
.room-challenge { background-color: rgb(230, 90, 150); }
.room-rest { background-color: rgb(110, 210, 130); }
.room-boss { background-color: rgb(150, 40, 40); color: rgb(240, 240, 240); }
