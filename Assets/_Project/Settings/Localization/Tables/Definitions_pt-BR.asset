  - m_Id: 2725806080
    m_Localized: Ember
    m_Metadata:
      m_Items: []
  - m_Id: 2956492800
    m_Localized: "Dano cont\xEDnuo, explos\xF5es e propaga\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 2969075712
    m_Localized: Frost
    m_Metadata:
      m_Items: []
  - m_Id: 2969075713
    m_Localized: "Controle, lentid\xE3o e congelamento."
    m_Metadata:
      m_Items: []
  - m_Id: 2969075714
    m_Localized: Storm
    m_Metadata:
      m_Items: []
  - m_Id: 2969075715
    m_Localized: Velocidade, encadeamento e sobrecarga.
    m_Metadata:
      m_Items: []
  - m_Id: 2969075716
    m_Localized: Void
    m_Metadata:
      m_Items: []
  - m_Id: 2969075717
    m_Localized: "Agrupamento, implos\xE3o e manipula\xE7\xE3o espacial."
    m_Metadata:
      m_Items: []
  - m_Id: 2969075718
    m_Localized: Echo
    m_Metadata:
      m_Items: []
  - m_Id: 2969075719
    m_Localized: "C\xF3pias, repeti\xE7\xE3o e efeitos atrasados."
    m_Metadata:
      m_Items: []
  - m_Id: 2969075720
    m_Localized: Ruin
    m_Metadata:
      m_Items: []
